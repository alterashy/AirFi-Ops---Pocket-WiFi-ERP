# Server Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="file:./dev.db"

# Payment Gateway (Midtrans Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-demo-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-demo-key
MIDTRANS_IS_PRODUCTION=false

# Automation n8n
# When running locally: http://localhost:5678/webhook/airfi-refund
# When running in Docker Compose: http://n8n:5678/webhook/airfi-refund
N8N_WEBHOOK_URL=http://localhost:5678/webhook/airfi-refund

# REST Countries v5 ( from https://restcountries.com/)
REST_COUNTRIES_API_KEY=rc_live_demo
